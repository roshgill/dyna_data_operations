{
  "manifest_version": 3,
  "name": "Dyna Ops: Encord Automations",
  "version": "0.18.59",
  "description": "Encord camera layout restore and incomplete Grade/Step annotation automations.",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": [
    "https://app.encord.com/*",
    "https://app.us.encord.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Dyna Ops: Encord Camera Layout. Click to restore layout · Right click to save layout | details",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.encord.com/*",
        "https://app.us.encord.com/*"
      ],
      "js": ["content.js", "trajectory-sync.js", "auto-scroll-next-step.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-world.js"],
      "matches": [
        "https://app.encord.com/*",
        "https://app.us.encord.com/*"
      ]
    }
  ]
}
