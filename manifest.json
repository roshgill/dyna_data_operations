{
  "manifest_version": 3,
  "name": "Encord Camera Layout",
  "version": "0.9.0",
  "description": "Restore your Encord camera layout. Warns when an episode's default cameras change.",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": [
    "https://app.encord.com/*",
    "https://app.us.encord.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Encord Camera Layout — click to restore · right-click for Save / details",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.encord.com/*",
        "https://app.us.encord.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-world.js"],
      "matches": [
        "https://app.encord.com/*",
        "https://app.us.encord.com/*"
      ]
    }
  ]
}
